NODE_ENV=development
API_PORT=3000
WEB_PORT=5173
LOG_LEVEL=info
DATABASE_URL=postgresql://attendance:attendance@localhost:5432/attendance
VITE_API_URL=http://localhost:3000/api
WEB_ORIGIN=http://localhost:5173
SESSION_HOURS=24
COOKIE_SECURE=false

# One-time bootstrap command credentials (do not keep production values in this file)
SUPER_ADMIN_NAME=Platform Administrator
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-at-least-12-characters

# S3-compatible object storage (used in a later phase)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=attendance-documents
S3_ACCESS_KEY=attendance
S3_SECRET_KEY=change-me
S3_FORCE_PATH_STYLE=true

# Optional future AI service-to-service ingestion secret
AI_INGESTION_KEY=
