NODE_ENV=production
POSTGRES_DB=attendance
POSTGRES_USER=attendance
POSTGRES_PASSWORD=replace-with-a-long-random-password
WEB_PORT=8080
WEB_BIND_ADDRESS=127.0.0.1
WEB_ORIGIN=https://attendance.example.com
COOKIE_SECURE=true
SESSION_HOURS=24
LOG_LEVEL=info
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=attendance-documents
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_FORCE_PATH_STYLE=true
AI_INGESTION_KEY=replace-with-a-long-random-service-secret
SUPER_ADMIN_NAME=Platform Administrator
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-long-random-password
